{
  "//": "Plantilla versionada. Copiar a appsettings.json (ignorado por git) o definir los mismos valores como variables de entorno en la nube: ConnectionStrings__DefaultConnection, Cors__AllowedOrigins__0, Storage__ProductImages__LocalPath, etc.",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1434;Database=AppPOS_DB;User Id=sa;Password=<PASSWORD>;TrustServerCertificate=True"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "Storage": {
    "ProductImages": {
      "Provider": "Local",
      "LocalPath": "wwwroot/uploads/products",
      "RequestPath": "/uploads/products",
      "PublicBaseUrl": null
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
